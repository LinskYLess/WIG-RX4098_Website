{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/arg/**/*.mjs", "src/content/**/*.mjs", "src/pages/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["dist", "node_modules"]
}
